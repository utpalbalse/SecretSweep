# Python compiled files - auto-generated by Python, no need to track them
__pycache__/
*.py[cod]
*.pyo

# Virtual environment folders - huge and machine-specific, everyone has their own
.venv/
venv/
env/

# Test and coverage output
.pytest_cache/
.coverage
htmlcov/

# IDE settings - personal to each developer's machine
.vscode/
.idea/

# OS junk files
.DS_Store
Thumbs.db

# Secrets - important for a secret scanner to never commit these itself
*.pem
*.key
.env
secrets.json
secrets.yaml